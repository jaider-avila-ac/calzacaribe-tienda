# En producción, VITE_API_URL debe ser el PROPIO dominio de esta tienda (ej.
# https://tienda.calzacaribe.com), NUNCA el del backend compartido (manzana.calzacaribe.com)
# directo — nginx.conf ya proxea /api/ y /ws hacia el backend desde acá. Si se llama directo al
# backend compartido, el navegador nunca toca el dominio real de la tienda, el backend no tiene
# cómo resolver el tenant por dominio y cae al respaldo (X-Tenant-Id) — un header que pone el
# propio cliente y que cualquiera puede cambiar con curl para ver el catálogo de OTRA tienda.
VITE_API_URL=http://localhost:8080

# Respaldo SOLO para desarrollo local (Vite en su propio puerto, sin el proxy de nginx.conf de
# por medio). Al duplicar este proyecto para OTRA tienda, cambiar solo para pruebas locales — usar
# el tnd_id real de esa tienda, nunca 1 (Calzacaribe).
VITE_TENANT_ID=1

VITE_PUBLIC_SITE_URL=https://www.tudominio.com

# Client ID de Google OAuth (Google Cloud Console → Credentials).
# El dominio real desde el que se sirva esta tienda debe estar agregado
# UNA SOLA VEZ en "Authorized JavaScript origins" de ese Client ID.
VITE_GOOGLE_CLIENT_ID=608123125346-9iad9jvkl49j9f3hj5piipolbkjm1h56.apps.googleusercontent.com
